# Copy to .env and fill in. Never commit .env.

# Port to listen on.
PORT=3006

# REQUIRED. Comma-separated hostnames this proxy may fetch from. Subdomains of a listed
# host are allowed, so "example.com" also permits "cdn.example.com".
#
# Set to * to allow any public host — the right choice when the proxy exists to solve CORS
# for arbitrary URLs rather than to front a known set of upstreams:
#     ALLOWED_HOSTS=*
#
# Either way, private and internal addresses (loopback, RFC1918, link-local, cloud
# metadata) are always blocked. That check is a separate layer from this list.
#
# The server refuses to start if this is empty. An unset variable and a deliberate "allow
# everything" should not look identical.
ALLOWED_HOSTS=*

# Comma-separated browser origins allowed to call the proxy.
# Leave empty to reject cross-origin browser requests entirely.
ALLOWED_ORIGINS=http://localhost:3000

# Abandon upstream requests after this many milliseconds.
REQUEST_TIMEOUT_MS=10000

# Reject upstream responses larger than this, in bytes.
MAX_RESPONSE_BYTES=5242880

# Rate limiting.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
RATE_LIMIT_DELAY_AFTER=60
RATE_LIMIT_DELAY_MS=500
