# Copy to .env and fill in. Never commit .env.

# Port to listen on.
PORT=3006

# Optional. Comma-separated hostnames this proxy may fetch from. Subdomains of a listed
# host are allowed, so "example.com" also permits "cdn.example.com".
#
# Defaults to * (any public host) when unset, so the service runs with no configuration.
# Narrow it only when the proxy fronts a known set of upstreams:
#     ALLOWED_HOSTS=arweave.net,nftstorage.link
#
# This setting never governs internal reachability. Private, loopback, link-local and
# cloud metadata addresses are rejected regardless of what is set here — that check is a
# separate layer.
ALLOWED_HOSTS=*

# Comma-separated browser origins allowed to call the proxy.
# Leave empty to reject cross-origin browser requests entirely.
ALLOWED_ORIGINS=http://localhost:3000

# Abandon upstream requests after this many milliseconds.
REQUEST_TIMEOUT_MS=10000

# Reject upstream responses larger than this, in bytes. Enforced against a running byte
# count while streaming, so an upstream that omits content-length cannot slip past it.
MAX_RESPONSE_BYTES=5242880

# Reject request payloads larger than this, in bytes. This proxy is GET-only and parses no
# body, so the default is deliberately small.
MAX_REQUEST_BYTES=8192

# Reject request URLs longer than this.
MAX_URL_LENGTH=4096

# Rate limiting.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
RATE_LIMIT_DELAY_AFTER=60
RATE_LIMIT_DELAY_MS=500
